{
  "name": "@layervai/qurl",
  "version": "0.7.0",
  "description": "TypeScript SDK for the qURL™ API — secure, time-limited access links. Quantum URL is how you enter the hidden layer of the internet.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "node": [
        "./dist/esm/node.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts' 'smoke/**/*.{cjs,mjs,ts,json}' 'scripts/**/*.mjs'",
    "format:check": "prettier --check 'src/**/*.ts' 'smoke/**/*.{cjs,mjs,ts,json}' 'scripts/**/*.mjs'",
    "smoke:dist": "node smoke/cjs.cjs && node smoke/esm.mjs && node smoke/node-cjs.cjs && node smoke/node-esm.mjs && node smoke/node-no-global-fetch.mjs && node scripts/smoke-node-legacy-types.mjs && node smoke/parity.mjs && node smoke/idempotency.mjs && node smoke/response-hardening.mjs && node smoke/public-id-delete.mjs && node smoke/connector-crid.mjs && node smoke/retired-agent-lifecycle.mjs",
    "prepublishOnly": "npm run build && npm run smoke:dist"
  },
  "keywords": [
    "qurl",
    "layervai",
    "security",
    "ai-agents",
    "zero-trust"
  ],
  "author": "LayerV AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/layervai/qurl-typescript"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@layervai/qurl-conformance": "0.15.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
